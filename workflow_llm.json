    {
      "parameters": {
        "jsCode": "// Забираем текстовую строку из ответа OpenRouter\nconst rawContent = $json.choices[0].message.content;\n\ntry {\n  // Превращаем строку обратно в JSON-объект\n  const parsedData = JSON.parse(rawContent);\n\n  // Возвращаем результат как новые поля в n8n\n  return {\n    cleaned_text: parsedData.cleaned_text,\n    category: parsedData.category,\n    summary: parsedData.summary\n  };\n} catch (error) {\n  // На случай, если нейросеть вернула некорректный JSON\n  return {\n    error: \"Не удалось распарсить JSON от ИИ\",\n    raw_response: rawContent\n  };\n}\n"
      },
